"│         │ <C-l>       pane.focus_right      Move focus to the pane on the right, openi │         │"
"│         │ <C-w>h      pane.focus_left       Move focus to the pane on the left, openin │         │"
"│         │ <C-w>l      pane.focus_right      Move focus to the pane on the right, openi │         │"
"│         │ <F1>        help.keys             Open the key cheat sheet                   │         │"
"│         │ Normal (Raw pane)                                                            │         │"
"│         │ /           search.forward        Search forward: type a pattern, Enter to g │         │"
"│         │ ?           search.backward       Search backward: type a pattern, Enter to  │         │"
"│         │ G           view.bottom           Go to the end of the file                  │         │"
"│         │ N           search.prev           Go to the previous match                   │         │"
"│         │ <C-b>       view.page_up          Scroll up a page                           │         │"
