---
source: crates/stede-tui/src/ui.rs
expression: "render(&mut app, 100, 40)"
---
"┌ Raw ─────────────────────────────────┐┌ Rendered ────────────────────────────┐┌ Files ───────────┐"
"│                                      ││                                      ││(empty)           │"
"│                                      ││                                      ││                  │"
"│                                      ││                                      ││                  │"
"│                                      ││                                      ││                  │"
"│                                      ││                                      ││                  │"
"│         ┌ Keys ────────────────────────────────────────────────────────────────────────┐         │"
"│         │ Keys      Action                Description                                  │         │"
"│         │ Normal (all panes)                                                           │         │"
"│         │ <Space>?  help.keys             Open the key cheat sheet                     │         │"
"│         │ <Space>c  config.problems       Show the config problems found at start      │         │"
"│         │ <Space>e  pane.toggle tree      Fold or open a pane: raw, rendered or tree   │         │"
"│         │ <Space>o  modal.reopen_last     Reopen the last output modal                 │         │"
"│         │ <Space>p  pane.toggle rendered  Fold or open a pane: raw, rendered or tree   │         │"
"│         │ <Space>r  pane.toggle raw       Fold or open a pane: raw, rendered or tree   │         │"
"│         │ <Space>z  pane.focus_one        Fold every pane but this one; again to resto │         │"
"│         │ ZQ        app.quit              Quit STEDE.md                                │         │"
"│         │ ZZ        app.quit              Quit STEDE.md                                │         │"
"│         │ <C-h>     pane.focus_left       Move focus to the pane on the left, opening  │         │"
"│         │ <C-l>     pane.focus_right      Move focus to the pane on the right, opening │         │"
"│         │ <C-w>h    pane.focus_left       Move focus to the pane on the left, opening  │         │"
"│         │ <C-w>l    pane.focus_right      Move focus to the pane on the right, opening │         │"
"│         │ <F1>      help.keys             Open the key cheat sheet                     │         │"
"│         │ Normal (Files pane)                                                          │         │"
"│         │ G         tree.bottom           Select the last entry in the file tree       │         │"
"│         │ gg        tree.top              Select the first entry in the file tree      │         │"
"│         │ h         tree.close            Close the selected folder, or go to its pare │         │"
"│         │ j         tree.down             Select the next entry in the file tree       │         │"
"│         │ k         tree.up               Select the previous entry in the file tree   │         │"
"│         │ l         tree.open             Open the selected folder or file; on an open │         │"
"│         │ <CR>      tree.open             Open the selected folder or file; on an open │         │"
"│         │ <Up>      tree.up               Select the previous entry in the file tree   │         │"
"│         └────────────────────────────────────────────────────────────── <Esc> to close ┘         │"
